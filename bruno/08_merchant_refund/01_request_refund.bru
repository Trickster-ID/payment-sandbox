meta {
  name: Request Refund
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/merchant/refunds
  body: json
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

headers {
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "invoice_id": "{{invoiceId}}",
    "reason": "Customer requested cancellation"
  }
}

script:post-response {
  if (res.status === 201 && res.body.data) {
    bru.setVar("refundId", res.body.data.id);
  }
}

tests {
  test("status 201", function() {
    expect(res.status).to.equal(201);
  });

  test("status is REQUESTED", function() {
    expect(res.body.data.status).to.equal("REQUESTED");
  });

  test("refundId saved to env", function() {
    expect(bru.getVar("refundId")).to.be.a("string");
  });
}
