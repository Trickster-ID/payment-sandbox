meta {
  name: Get Invoice Detail
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/merchant/invoices/{{invoiceId}}
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("id matches", function() {
    expect(res.body.data.id).to.equal(bru.getVar("invoiceId"));
  });

  test("status is PENDING or PAID", function() {
    expect(["PENDING", "PAID", "EXPIRED"]).to.include(res.body.data.status);
  });
}
