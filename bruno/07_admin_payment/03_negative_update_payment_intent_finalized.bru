meta {
  name: Admin Update Payment Intent Status - FAILED (already finalized)
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/admin/payment-intents/{{paymentIntentId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "status": "FAILED"
  }
}

tests {
  test("status 400 (already finalized)", function() {
    expect(res.status).to.equal(400);
  });

  test("error code payment_intent_update_failed", function() {
    expect(res.body.error.code).to.equal("payment_intent_update_failed");
  });
}
