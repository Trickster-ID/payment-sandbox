meta {
  name: Admin Wallet - Negative - Invalid Direction Filter
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/admin/wallet/transactions?direction=X
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("status 400", function() {
    expect(res.status).to.equal(400);
  });

  test("error code validation_error", function() {
    expect(res.body.error.code).to.equal("validation_error");
  });
}
