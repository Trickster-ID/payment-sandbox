meta {
  name: Admin Review Refund - APPROVE
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/admin/refunds/{{refundId}}/review
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "decision": "APPROVE"
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("status is APPROVED", function() {
    expect(res.body.data.status).to.equal("APPROVED");
  });
}
