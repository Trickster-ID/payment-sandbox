meta {
  name: List OAuth2 Clients
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/merchant/clients
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("data is array", function() {
    expect(res.body.data).to.be.an("array");
  });
}
