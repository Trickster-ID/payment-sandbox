meta {
  name: OAuth2 Token - Password Grant (Admin)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/oauth2/token
  body: text
  auth: none
}

body:text {
  placeholder (built in pre-request script; see note in 02_oauth2_token_password_merchant.bru)
}

script:pre-request {
  const adminEmail = bru.getEnvVar("adminEmail");
  const adminPassword = bru.getEnvVar("adminPassword");
  const clientId = bru.getEnvVar("oauth2ClientId");
  const clientSecret = bru.getEnvVar("oauth2ClientSecret");

  req.setHeader("Content-Type", "application/x-www-form-urlencoded");
  req.setBody(
    "grant_type=password" +
    "&username=" + encodeURIComponent(adminEmail) +
    "&password=" + encodeURIComponent(adminPassword) +
    "&client_id=" + encodeURIComponent(clientId) +
    "&client_secret=" + encodeURIComponent(clientSecret) +
    "&scope=read+write+admin"
  );
}

script:post-response {
  if (res.status === 200 && res.body.data) {
    bru.setVar("adminToken", res.body.data.access_token);
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("access_token present", function() {
    expect(res.body.data.access_token).to.be.a("string");
  });

  test("token_type is Bearer", function() {
    expect(res.body.data.token_type).to.equal("Bearer");
  });
}
