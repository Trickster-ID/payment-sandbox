meta {
  name: OAuth2 Revoke Token
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/oauth2/revoke
  body: text
  auth: none
}

body:text {
  placeholder (built in pre-request script; see note in 02_oauth2_token_password_merchant.bru)
}

script:pre-request {
  const token = bru.getVar("refreshToken");
  const clientId = bru.getEnvVar("oauth2ClientId");
  const clientSecret = bru.getEnvVar("oauth2ClientSecret");

  req.setHeader("Content-Type", "application/x-www-form-urlencoded");
  req.setBody(
    "token=" + encodeURIComponent(token) +
    "&client_id=" + encodeURIComponent(clientId) +
    "&client_secret=" + encodeURIComponent(clientSecret)
  );
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("status revoked", function() {
    expect(res.body.data.status).to.equal("revoked");
  });
}
