meta {
  name: Auth - Negative - Invalid Credentials
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/oauth2/token
  body: text
  auth: none
}

body:text {
  placeholder (built in pre-request script; see note in 02_oauth2_token_password_merchant.bru)
}

script:pre-request {
  const clientId = bru.getEnvVar("oauth2ClientId");
  const clientSecret = bru.getEnvVar("oauth2ClientSecret");

  req.setHeader("Content-Type", "application/x-www-form-urlencoded");
  req.setBody(
    "grant_type=password" +
    "&username=" + encodeURIComponent("wrong@example.com") +
    "&password=" + encodeURIComponent("wrongpassword") +
    "&client_id=" + encodeURIComponent(clientId) +
    "&client_secret=" + encodeURIComponent(clientSecret)
  );
}

tests {
  test("status 401", function() {
    expect(res.status).to.equal(401);
  });

  test("error code invalid_grant", function() {
    expect(res.body.error.code).to.equal("invalid_grant");
  });
}
