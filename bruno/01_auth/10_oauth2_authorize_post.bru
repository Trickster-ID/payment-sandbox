meta {
  name: OAuth2 Authorize - POST (no session, expect 401)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/oauth2/authorize
  body: text
  auth: none
}

body:text {
  placeholder (built in pre-request script; see note in 02_oauth2_token_password_merchant.bru)
}

script:pre-request {
  const clientId = bru.getEnvVar("oauth2ClientId");
  req.setHeader("Content-Type", "application/x-www-form-urlencoded");
  req.setBody(
    "response_type=code" +
    "&client_id=" + encodeURIComponent(clientId) +
    "&redirect_uri=" + encodeURIComponent("http://localhost:3000/callback") +
    "&scope=read" +
    "&state=bruno-test"
  );
}

tests {
  test("status 401 without auth context", function() {
    expect(res.status).to.equal(401);
  });

  test("error code auth_unauthorized", function() {
    expect(res.body.error.code).to.equal("auth_unauthorized");
  });
}
