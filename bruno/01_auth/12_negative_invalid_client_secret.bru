meta {
  name: Auth - Negative - Invalid Client Secret
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/oauth2/token
  body: text
  auth: none
}

body:text {
  placeholder (built in pre-request script; see note in 02_oauth2_token_password_merchant.bru)
}

script:pre-request {
  const adminEmail = bru.getEnvVar("adminEmail");
  const adminPassword = bru.getEnvVar("adminPassword");
  const clientId = bru.getEnvVar("oauth2ClientId");

  req.setHeader("Content-Type", "application/x-www-form-urlencoded");
  req.setBody(
    "grant_type=password" +
    "&username=" + encodeURIComponent(adminEmail) +
    "&password=" + encodeURIComponent(adminPassword) +
    "&client_id=" + encodeURIComponent(clientId) +
    "&client_secret=wrong-secret"
  );
}

tests {
  test("status 401", function() {
    expect(res.status).to.equal(401);
  });

  test("error code invalid_client", function() {
    expect(res.body.error.code).to.equal("invalid_client");
  });
}
