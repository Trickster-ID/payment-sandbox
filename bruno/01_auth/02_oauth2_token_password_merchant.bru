meta {
  name: OAuth2 Token - Password Grant (Merchant)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/oauth2/token
  body: text
  auth: none
}

body:text {
  placeholder (built in pre-request script; see note below)
}

script:pre-request {
  // NOTE: Bruno CLI 3.5.2 has a bug where setting Content-Type to
  // application/x-www-form-urlencoded (via a `headers {}` block) disables
  // {{var}} interpolation inside `body:text`. Workaround: build the body
  // manually here using bru.getVar() (runtime vars set via bru.setVar())
  // and bru.getEnvVar() (static vars declared in the environment file).
  const merchantEmail = bru.getVar("merchantEmail") || bru.getEnvVar("merchantEmail");
  const merchantPassword = bru.getVar("merchantPassword") || bru.getEnvVar("merchantPassword");
  const clientId = bru.getEnvVar("oauth2ClientId");
  const clientSecret = bru.getEnvVar("oauth2ClientSecret");

  req.setHeader("Content-Type", "application/x-www-form-urlencoded");
  req.setBody(
    "grant_type=password" +
    "&username=" + encodeURIComponent(merchantEmail) +
    "&password=" + encodeURIComponent(merchantPassword) +
    "&client_id=" + encodeURIComponent(clientId) +
    "&client_secret=" + encodeURIComponent(clientSecret) +
    "&scope=read+write"
  );
}

script:post-response {
  if (res.status === 200 && res.body.data) {
    bru.setVar("merchantToken", res.body.data.access_token);
    bru.setVar("refreshToken", res.body.data.refresh_token);
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("access_token present", function() {
    expect(res.body.data.access_token).to.be.a("string");
  });

  test("token_type is Bearer", function() {
    expect(res.body.data.token_type).to.equal("Bearer");
  });

  test("refresh_token present", function() {
    expect(res.body.data.refresh_token).to.be.a("string");
  });
}
