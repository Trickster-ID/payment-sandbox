meta {
  name: OAuth2 Token - Refresh Token Grant
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/oauth2/token
  body: text
  auth: none
}

body:text {
  placeholder (built in pre-request script; see note in 02_oauth2_token_password_merchant.bru)
}

script:pre-request {
  const refreshToken = bru.getVar("refreshToken");
  const clientId = bru.getEnvVar("oauth2ClientId");
  const clientSecret = bru.getEnvVar("oauth2ClientSecret");

  req.setHeader("Content-Type", "application/x-www-form-urlencoded");
  req.setBody(
    "grant_type=refresh_token" +
    "&refresh_token=" + encodeURIComponent(refreshToken) +
    "&client_id=" + encodeURIComponent(clientId) +
    "&client_secret=" + encodeURIComponent(clientSecret)
  );
}

script:post-response {
  if (res.status === 200 && res.body.data) {
    bru.setVar("merchantToken", res.body.data.access_token);
    bru.setVar("refreshToken", res.body.data.refresh_token);
  }
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("new access_token present", function() {
    expect(res.body.data.access_token).to.be.a("string");
  });

  test("new refresh_token present", function() {
    expect(res.body.data.refresh_token).to.be.a("string");
  });
}
