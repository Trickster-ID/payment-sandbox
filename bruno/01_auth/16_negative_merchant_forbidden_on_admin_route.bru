meta {
  name: Auth - Negative - Merchant Forbidden on Admin Route
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/admin/stats
  auth: bearer
}

auth:bearer {
  token: {{merchantToken}}
}

tests {
  test("status 403", function() {
    expect(res.status).to.equal(403);
  });

  test("error code auth_forbidden", function() {
    expect(res.body.error.code).to.equal("auth_forbidden");
  });
}
