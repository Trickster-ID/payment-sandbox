meta {
  name: Admin Stats - Negative - Invalid Date
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/admin/stats?start_date=2026-01-99
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("status 400", function() {
    expect(res.status).to.equal(400);
  });

  test("error code stats_query_failed", function() {
    expect(res.body.error.code).to.equal("stats_query_failed");
  });
}
