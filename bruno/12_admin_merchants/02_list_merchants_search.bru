meta {
  name: Admin List Merchants - Search
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/admin/merchants?search=merchant&page=1&limit=20
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("data is array", function() {
    expect(res.body.data).to.be.an("array");
  });
}
