meta {
  name: Admin List Merchants
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/admin/merchants?page=1&limit=20
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });

  test("data is array", function() {
    expect(res.body.data).to.be.an("array");
  });

  test("meta has pagination", function() {
    expect(res.body.meta.page).to.equal(1);
    expect(res.body.meta.limit).to.equal(20);
  });
}
