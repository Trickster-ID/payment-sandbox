meta {
  name: Ledger - Negative - Invalid Merchant UUID
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/admin/ledger/accounts/not-a-uuid
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("status 400", function() {
    expect(res.status).to.equal(400);
  });

  test("error code invalid_merchant_id", function() {
    expect(res.body.error.code).to.equal("invalid_merchant_id");
  });
}
